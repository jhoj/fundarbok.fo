# Fundarbok Environment Configuration
# Copy this file to .env and configure your settings

# ===========================================
# CUSTOMER SETTINGS
# ===========================================

# Customer name (used for Docker project naming)
CUSTOMER_NAME=test

# Customer domain (for CORS and SSL)
CUSTOMER_DOMAIN=test.fundarbokin.hoj.fo

# ===========================================
# DOCKER SETTINGS
# ===========================================

# Docker project name prefix
COMPOSE_PROJECT_NAME=fundarbok_test

# Docker registry (change to your registry)
DOCKER_REGISTRY=ghcr.io/jhoj

# Image tag to use (latest, or specific SHA)
IMAGE_TAG=latest

# Port to expose frontend (each customer needs unique port)
FRONTEND_PORT=8001

# ===========================================
# DATABASE SETTINGS
# ===========================================

# PostgreSQL credentials
DB_USER=fundarbok
DB_PASSWORD=CHANGE_ME_GENERATE_RANDOM_PASSWORD
DB_NAME=fundarbok

# ===========================================
# JWT AUTHENTICATION
# ===========================================

# JWT secret key (minimum 32 characters, keep secret!)
# Generate with: openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 64
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_MIN_32_CHARS

# JWT token settings
JWT_ISSUER=Fundarbok.API
JWT_AUDIENCE=Fundarbok.Web
JWT_EXPIRATION_HOURS=24

# ===========================================
# PUSH NOTIFICATIONS (Optional)
# ===========================================

# VAPID keys for web push notifications
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===========================================
# CORS SETTINGS
# ===========================================

# Allowed CORS origin (auto-set based on CUSTOMER_DOMAIN for production)
CORS_ORIGIN=https://test.fundarbokin.hoj.fo
