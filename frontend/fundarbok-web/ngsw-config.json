{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "meetings",
      "urls": ["/api/meetings/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxAge": "1h",
        "maxSize": 100
      }
    },
    {
      "name": "documents",
      "urls": ["/api/documents/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxAge": "24h",
        "maxSize": 50
      }
    },
    {
      "name": "committees",
      "urls": ["/api/committees/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxAge": "24h",
        "maxSize": 20
      }
    },
    {
      "name": "agenda-items",
      "urls": ["/api/agendaitems/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxAge": "1h",
        "maxSize": 50
      }
    },
    {
      "name": "notes-tasks",
      "urls": ["/api/notes/**", "/api/tasks/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxAge": "30m",
        "maxSize": 30
      }
    }
  ]
}
